<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="TimetableView">
        <!-- 헤더 하이라이트 타입: circle or image -->
        <attr name="header_highlight_type" format="enum">
            <enum name="circle" value="0"/>
            <enum name="image" value="1"/>
        </attr>

        <!-- 하이라이트 이미지 리소스 -->
        <attr name="header_highlight_image" format="reference"/>

        <!-- 하이라이트 이미지 크기 -->
        <attr name="header_highlight_image_size" format="dimension"/>

        <!-- 헤더 요일 이름 텍스트 색상 -->
        <attr name="header_text_color" format="color"/>

        <!-- 헤더 배경색 -->
        <attr name="header_background" format="color"/>

        <!-- 스티커 배경색 -->
        <attr name="sticker_color" format="color"/>

        <!-- 스티커 텍스트 색상 -->
        <attr name="sticker_text_color" format="color"/>

        <!-- 시작 시간 (예: 9시) -->
        <attr name="start_hour" format="integer"/>

        <!-- 종료 시간 (예: 18시) -->
        <attr name="end_hour" format="integer"/>

        <!-- 요일 수 (5: 평일, 7: 주간) -->
        <attr name="day_count" format="integer"/>

        <!-- 요일 표시 텍스트 -->
        <attr name="day_labels" format="reference"/> <!-- @array 리소스 -->

        <!-- 시간 간격 -->
        <attr name="time_interval" format="integer"/>
    </declare-styleable>
</resources>
