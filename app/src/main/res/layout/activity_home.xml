<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <!-- 제목 텍스트뷰 -->
    <TextView
        android:id="@+id/homeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="0dp"
        android:layout_marginTop="50dp"/>

    <TextView
        android:id="@+id/nicknameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_below="@id/titleText"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp" />

    <TextView
        android:id="@+id/adviceTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="명언을 불러오는 중..."
        android:textSize="14sp"
        android:textColor="#808080"
        android:textStyle="italic"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="40dp"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/grid0"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_margin="10dp"
        app:cardCornerRadius="15dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@android:color/white">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <!-- 현재 시간 (왼쪽 상단) -->
            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="시간 가져오는 중..."
                android:textSize="19sp"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <!-- 날씨 이미지 (중앙 위치) -->
            <ImageView
                android:id="@+id/iv_weather_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:layout_constraintTop_toBottomOf="@id/tv_time"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="8dp"
                android:contentDescription="Weather Icon"/>

            <!-- 지역명 -->
            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 지역을 불러오는중.."
                android:textSize="15sp"
                android:textColor="@android:color/black"
                android:layout_marginBottom="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- 날씨 정보 (오른쪽 하단) -->
            <TextView
                android:id="@+id/tv_weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="날씨 정보를 불러오는 중..."
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>


    <!-- GridLayout 사용: 한 줄에 2개씩 배치 -->
    <GridLayout
        android:id="@+id/grid1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="1"
        android:layout_gravity="center"
        android:layout_marginBottom="10dp"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@+id/grid0">

        <!-- 지도 버튼 (CardView) -->
        <androidx.cardview.widget.CardView
            android:layout_width="170dp"
            android:layout_height="100dp"
            android:layout_margin="2dp"
            android:layout_marginLeft="12dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="8dp"
            android:layout_gravity="center">

            <!-- 내부 ConstraintLayout -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- GIF 이미지 -->
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/mapAnimationView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:lottie_rawRes="@raw/map_icon"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    android:scaleType="fitXY"
                    android:contentDescription="지도 애니메이션"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="-20dp" />


                <!-- 버튼 (GIF 위에 배치) -->
                <Button
                    android:id="@+id/mapButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="지도"
                    android:textSize="18sp"
                    android:textColor="@android:color/black"
                    android:background="@android:color/transparent"
                    android:gravity="right|center"
                    android:layout_marginRight="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- 강의실 찾기 버튼 (CardView) -->
        <androidx.cardview.widget.CardView
            android:layout_width="170dp"
            android:layout_height="100dp"
            android:layout_margin="2dp"
            android:layout_marginLeft="10dp"
            android:layout_marginEnd="12dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="8dp"
            android:layout_gravity="center">

            <!-- 내부 ConstraintLayout -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- GIF 이미지 -->
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/timetableAnimationView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:lottie_rawRes="@raw/findclass_icon"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    android:scaleType="fitXY"
                    android:contentDescription="강의실찾기 애니메이션"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="-20dp"/>


                <!-- 버튼 (GIF 위에 배치) -->
                <Button
                    android:id="@+id/roomFinderButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginRight="12dp"
                    android:background="@android:color/transparent"
                    android:gravity="right|center"
                    android:text="강의실\n찾기"
                    android:textColor="@android:color/black"
                    android:textSize="18sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </GridLayout>

    <GridLayout
        android:id="@+id/grid2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:useDefaultMargins="true"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintTop_toBottomOf="@+id/grid1">

        <!-- 시간표 -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_columnWeight="1"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            android:layout_gravity="fill_horizontal|center_vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/timetableButton"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/timetable_icon"
                    android:background="@null"
                    android:contentDescription="시간표 버튼" />

                <TextView
                    android:id="@+id/timetableText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="시간표"
                    android:textSize="13sp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:paddingTop="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 정보 -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_columnWeight="1"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            android:layout_gravity="fill_horizontal|center_vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/infoButton"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/info_icon"
                    android:background="@null"
                    android:contentDescription="정보 버튼" />

                <TextView
                    android:id="@+id/infoText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="정보"
                    android:textSize="13sp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:paddingTop="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 고객센터 -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_columnWeight="1"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            android:layout_gravity="fill_horizontal|center_vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/helpButton"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/help_icon"
                    android:background="@null"
                    android:contentDescription="고객센터 버튼" />

                <TextView
                    android:id="@+id/helpText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="고객센터"
                    android:textSize="13sp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:paddingTop="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </GridLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="제작자:이거라도 자바"
        android:textSize="15sp"
        android:layout_gravity="center"
        android:layout_weight="1"/>

</LinearLayout>
