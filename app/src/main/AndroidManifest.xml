<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 필수 권한들 설정 -->
    <!-- 인터넷 사용 권한 (API 요청 등 네트워크 통신용) -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 정밀한 위치 정보 (GPS 등) 사용 권한 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- 대략적인 위치 정보 (Wi-Fi, 셀룰러) 사용 권한 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- 블루투스 관련 권한 -->
    <!-- Android 12 미만에서 BLE 스캔 및 연결을 위한 권한 -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
    <!-- Android 12 이상에서 BLE 스캔을 위한 권한 -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" tools:targetApi="s"/>
    <!-- Android 12 이상에서 BLE 장치 연결을 위한 권한 -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>

    <!-- 저장소 관련 권한 -->
    <!-- Android 12 이하에서 외부 저장소 이미지 접근 권한 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <!-- Android 13 이상에서 이미지 접근 권한 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 14 이상에서 사용자가 직접 선택한 이미지 접근 권한 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="31"
        android:usesCleartextTraffic="true">

        <!-- 앱 시작 화면 (튜토리얼) -->
        <activity android:name=".TutorialActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 홈 화면 액티비티 -->
        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:theme="@style/AppTheme"/>

        <!-- 메인 지도 기능 포함한 액티비티 -->
        <activity android:name=".MainActivity" android:screenOrientation="fullSensor"/>

        <!-- 시간표 기능 액티비티 -->
        <activity android:name=".TimetableActivity"/>

        <!-- 웹뷰를 활용한 화면 -->
        <activity android:name=".WebView"/>

        <!-- 정보 제공 메인 화면 -->
        <activity android:name=".Info_main"/>

        <!-- 사용자 지원 관련 액티비티 -->
        <activity android:name=".SupportActivity"/>
        <activity android:name=".SupportRequestActivity"/>

        <!-- 프로필 편집 화면 -->
        <activity android:name=".EditProfileActivity" />

        <!-- 기타 기능 액티비티 -->
        <activity
            android:name=".MainActivity2"
            android:theme="@style/AppTheme"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|stateUnchanged"/>

        <!-- 상세 정보 화면 -->
        <activity android:name=".DetilActivity" android:theme="@style/AppTheme"/>

        <!-- 비콘 연동 이미지 뷰어 액티비티 (좌/우/중앙 버전 별도) -->
        <activity
            android:name=".BeaconImageActivity2_1_L"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AppTheme"
            android:exported="true"/>
        <activity
            android:name=".BeaconImageActivity2_2_L"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AppTheme"
            android:exported="true"/>
        <activity
            android:name=".BeaconImageActivity3_1_L"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AppTheme"
            android:exported="true"/>
        <activity
            android:name=".BeaconImageActivity3_1_R"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AppTheme"
            android:exported="true"/>
        <activity
            android:name=".BeaconImageActivity3_1_C"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AppTheme"
            android:exported="true"/>

        <!-- 편집 화면 -->
        <activity android:name=".EditActivity">
            <!-- 필요 시 인텐트 필터 추가 가능 -->
        </activity>

        <!-- 도움말 화면 -->
        <activity android:name=".Help" android:theme="@style/AppTheme"/>

        <!-- QR 코드 스캔 화면 -->
        <activity
            android:name=".QrCodeScanActivity"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AppTheme"
            android:screenOrientation="fullSensor"
            android:exported="true"
            tools:ignore="DiscouragedApi"/>

        <!-- 바코드/QR 스캔용 외부 라이브러리 액티비티 -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            android:exported="true"
            tools:replace="android:screenOrientation"
            tools:ignore="DiscouragedApi" />

        <!-- 비콘 연결 서비스 -->
        <service android:name="com.minew.beaconset.ConnectService"/>

        <!-- 블루투스 상태 변화 수신 리시버 -->
        <receiver
            android:name="com.minew.beaconset.BluetoothChangedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.bluetooth.adapter.action.STATE_CHANGED"/>
            </intent-filter>
        </receiver>

        <!-- 네이버 지도 API 키 등록 -->
        <meta-data
            android:name="com.naver.maps.map.CLIENT_ID"
            android:value="${naverMapsClientId}"/>

    </application>
</manifest>
